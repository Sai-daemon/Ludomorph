{
  "version": "1.0.0",
  "macros": [
    {
      "name": "move_forward",
      "description": "Press W for half a second",
      "actions": [
        {
          "type": "key",
          "key": "w",
          "hold_ms": 500
        }
      ]
    },
    {
      "name": "jump",
      "description": "Quick spacebar tap",
      "actions": [
        {
          "type": "key",
          "key": "space",
          "hold_ms": 100
        }
      ]
    },
    {
      "name": "ui_click_top_left",
      "description": "Move mouse to (100, 200) and left click",
      "actions": [
        {
          "type": "mouse_move",
          "x": 100,
          "y": 200,
          "relative": false
        },
        {
          "type": "click",
          "button": "left"
        }
      ]
    },
    {
